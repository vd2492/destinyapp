# Copy this file to `keystore.properties` (which is gitignored) and fill in your
# real values. The release build auto-signs only when keystore.properties exists.
#
# Generate the keystore once with:
#   keytool -genkeypair -v -keystore destiny-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias destiny
#
# Keep destiny-release.jks and these passwords backed up somewhere safe and private.
# Losing them means you can never publish an update to this app on Google Play.

storeFile=destiny-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=destiny
keyPassword=YOUR_KEY_PASSWORD
